# Plantilla de variables de entorno (PRD §12). Copia a `.env` en la raíz y rellena.
# NUNCA commitees `.env` (está en .gitignore). Los secretos solo viven aquí en local
# o en el `.env` de producción del VPS.

# --- API ---
NODE_ENV=development
PORT=4000
# En dev la BD corre en Docker (infra/docker-compose.yml) expuesta en localhost:5432.
# En prod el host es el servicio `db` de la red interna de Docker (no expuesto a internet).
DATABASE_URL=postgres://tar:tar@localhost:5432/tar_portal
JWT_ACCESS_SECRET=dev-access-secret-cambia-esto
JWT_REFRESH_SECRET=dev-refresh-secret-cambia-esto
CORS_ORIGINS=http://localhost:3000

# --- Credenciales de la BD (las consume docker-compose) ---
POSTGRES_USER=tar
POSTGRES_PASSWORD=tar
POSTGRES_DB=tar_portal

# --- Storage local (disco del VPS Hostinger) ---
STORAGE_DRIVER=local
MEDIA_DIR=./uploads
MEDIA_BASE_URL=http://localhost:4000/media
# Base del sitio público (SIN barra final). Se usa para armar el enlace `url` de la
# propiedad en los webhooks salientes (property.published). En producción pon el dominio
# real, p.ej.: PUBLIC_SITE_URL=https://tarinternacional.com
PUBLIC_SITE_URL=http://localhost:3000

# Secreto compartido con el sitio Next.js para la revalidación on-demand (ISR): al
# publicar/despublicar/cambiar estatus, la API avisa a `PUBLIC_SITE_URL/revalidate`
# para refrescar el sitio al instante. DEBE ser idéntico al del bloque Web de abajo.
# Vacío en dev = revalidación desactivada (el sitio se refresca solo por tiempo).
REVALIDATE_SECRET=

# --- Conversión para filtros/orden (el display siempre usa la moneda original) ---
USD_MXN_RATE=18.50

# --- Respaldos off-site — Cloudflare R2 (cuenta del cliente, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tar-respaldos

# --- Email (SendGrid) ---
SENDGRID_API_KEY=
LEADS_NOTIFY_TO=ventas@tarinternacional.com

# --- Geocoding del importador (servidor; sin key → propiedades en borrador) ---
GOOGLE_GEOCODING_API_KEY=

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Mapa: Leaflet + mosaicos de CARTO sobre datos de OpenStreetMap. NO requiere
# llave ni cuenta de facturación (desviación del PRD §7.0, decidida con el cliente
# el 2026-08-03). Ambas variables son OPCIONALES: si se dejan vacías se usan los
# valores por defecto de `apps/web/lib/maps.ts`. Solo hay que tocarlas para cambiar
# de proveedor de mosaicos (MapTiler, Stadia, servidor propio).
# La atribución es OBLIGATORIA por la licencia de OpenStreetMap: no la quites.
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_TILES_ATTRIBUTION=
# Radio en METROS del círculo de "zona aproximada" que se dibuja alrededor del pin
# en el mapa de la ficha (el portal no publica la ubicación al metro). Vacío = 400.
NEXT_PUBLIC_MAP_AREA_RADIUS_M=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secreto de la revalidación on-demand (mismo valor que el REVALIDATE_SECRET de la
# API). Variable de SERVIDOR (no NEXT_PUBLIC_): solo la lee el route handler /revalidate.
REVALIDATE_SECRET=

# --- Despliegue en el VPS (solo producción; en dev se dejan vacías) ---
# Las consume docker-compose/Caddy al desplegar con `./infra/deploy.sh`.
# Ver docs/README-DEPLOY.md.
# Dominio que atiende Caddy, SIN https:// ni www (el www redirige solo).
SITE_DOMAIN=
# Correo al que Let's Encrypt avisa si un certificado va a vencer.
ACME_EMAIL=
# Carpeta de imágenes EN EL SERVIDOR (se monta dentro del contenedor como MEDIA_DIR).
# Debe existir y pertenecer al uid 1000:  sudo mkdir -p /srv/tar/media && sudo chown -R 1000:1000 /srv/tar/media
MEDIA_HOST_DIR=/srv/tar/media
# Zona horaria de los contenedores (fechas de leads y publicaciones).
TZ=America/Mexico_City
