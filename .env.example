# Plantilla de variables de entorno (PRD §12). Copia a `.env` en la raíz y rellena.
# NUNCA commitees `.env` (está en .gitignore). Los secretos solo viven aquí en local
# o en el `.env` de producción del VPS.

# --- API ---
NODE_ENV=development
PORT=4000
# En dev la BD corre en Docker (infra/docker-compose.yml) expuesta en localhost:5432.
# En prod el host es el servicio `db` de la red interna de Docker (no expuesto a internet).
DATABASE_URL=postgres://tar:tar@localhost:5432/tar_portal
JWT_ACCESS_SECRET=dev-access-secret-cambia-esto
JWT_REFRESH_SECRET=dev-refresh-secret-cambia-esto
CORS_ORIGINS=http://localhost:3000

# --- Credenciales de la BD (las consume docker-compose) ---
POSTGRES_USER=tar
POSTGRES_PASSWORD=tar
POSTGRES_DB=tar_portal

# --- Storage local (disco del VPS Hostinger) ---
STORAGE_DRIVER=local
MEDIA_DIR=./uploads
MEDIA_BASE_URL=http://localhost:4000/media

# --- Conversión para filtros/orden (el display siempre usa la moneda original) ---
USD_MXN_RATE=18.50

# --- Respaldos off-site — Cloudflare R2 (cuenta del cliente, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tar-respaldos

# --- Email (SendGrid) ---
SENDGRID_API_KEY=
LEADS_NOTIFY_TO=ventas@tarinternacional.com

# --- Geocoding del importador (servidor; sin key → propiedades en borrador) ---
GOOGLE_GEOCODING_API_KEY=

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
